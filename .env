# Shikhar environment variables
# Copy this file to .env.local and fill in real values for production.
# Never commit .env.local.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shikhar?schema=public"
REDIS_URL="redis://localhost:6379"

# Upstash Redis (optional; used when KV_ADAPTER=upstash)
KV_ADAPTER="memory"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

ADMIN_SECRET="dev-secret"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=""

NODE_ENV="development"
